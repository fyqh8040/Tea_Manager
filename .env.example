# Database Connection (PostgreSQL - Supabase / Neon / RDS)
DATABASE_URL=postgres://postgres:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# JWT Secret for Session Signing
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars

# Supabase API (Optional - for future storage extensions)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Image Bed API (Optional - e.g. Cloudflare-ImgBed / Telegraph)
NEXT_PUBLIC_IMAGE_API_URL=https://your-image-bed-worker.workers.dev/upload
NEXT_PUBLIC_IMAGE_API_TOKEN=your-image-api-token
